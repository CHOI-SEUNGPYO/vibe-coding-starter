  "components": {
    "schemas": {
      "Book": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[^\\x00]*$",
            "title": "Title"
          },
          "author": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[^\\x00]*$",
            "title": "Author"
          },
          "status": {
            "type": "string",
            "enum": [
              "want",
              "reading",
              "done"
            ],
            "title": "Status",
            "default": "want"
          },
          "note": {
            "type": "string",
            "maxLength": 5000,
            "title": "Note",
            "default": ""
          },
          "id": {
            "type": "integer",
            "title": "Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "author",
          "id"
        ],
        "title": "Book"
      },
      "BookCreate": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[^\\x00]*$",
            "title": "Title"
          },
          "author": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[^\\x00]*$",
            "title": "Author"
          },
          "status": {
            "type": "string",
            "enum": [
              "want",
              "reading",
              "done"
            ],
            "title": "Status",
            "default": "want"
          },
          "note": {
            "type": "string",
            "maxLength": 5000,
            "title": "Note",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "author"
        ],
        "title": "BookCreate"
      },
      "BookList": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/Book"
            },
            "type": "array",
            "title": "Data"
          },
          "pagination": {
            "$ref": "#/components/schemas/Pagination"
          }
        },
        "type": "object",
        "required": [
          "data",
          "pagination"
        ],
        "title": "BookList"
      },
      "BookPatch": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[^\\x00]*$",
            "title": "Title"
          },
          "author": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[^\\x00]*$",
            "title": "Author"
          },
          "status": {
            "type": "string",
            "enum": [
              "want",
              "reading",
              "done"
            ],
            "title": "Status"
          },
          "note": {
            "type": "string",
            "maxLength": 5000,
            "title": "Note"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "BookPatch"
      },
      "Error": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": "array",
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "Error"
      },
      "ErrorDetail": {
        "properties": {
          "location": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Type"
          }
        },
        "type": "object",
        "required": [
          "location",
          "message",
          "type"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Health"
      },
      "Pagination": {
        "properties": {
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "pageSize": {
            "type": "integer",
            "title": "Pagesize"
          },
          "totalItems": {
            "type": "integer",
            "title": "Totalitems"
          },
          "totalPages": {
            "type": "integer",
            "title": "Totalpages"
          }
        },
        "type": "object",
        "required": [
          "page",
          "pageSize",
          "totalItems",
          "totalPages"
        ],
        "title": "Pagination"
      }
    },
    "securitySchemes": {
      "ReadingLogToken": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
